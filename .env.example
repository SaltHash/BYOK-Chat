SEARXNG_BASE_URL=http://127.0.0.1:8080
SEARCH_TIMEOUT_MS=8000
SEARCH_MAX_RESULTS=8
SEARCH_MAX_SNIPPET_CHARS=1800
SEARCH_EVIDENCE_BUDGET=12000
# Search mode: api | searxng (default api)
SEARCH_MODE=api
# Fall back onto the other search when the primary fails (default true).
SEARCH_FALLBACK=true
# API provider: tinyfish | you | exa | firecrawl | brightdata (default tinyfish)
SEARCH_API_PROVIDER=tinyfish
# Optional shared server keys. Browsers can also bring their own API key
# (stored locally, sent with each search request) which takes precedence.
SEARCH_API_KEY=
TINYFISH_API_KEY=
YOU_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
BRIGHTDATA_API_KEY=
# Bright Data SERP zone name (required for brightdata).
SEARCH_API_ZONE=
# Optional endpoint override (or SEARCH_API_URL_<PROVIDER> per provider).
SEARCH_API_URL=
# Bounded retries for transient search failures (429/5xx/timeouts). 4xx is never retried.
SEARCH_MAX_RETRIES=2
SEARCH_RETRY_BASE_MS=300
